# ---- Claude (research with web search + content writing) ----
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# RESEARCH_EFFORT=medium
# GENERATION_EFFORT=high
# MAX_WEB_SEARCHES=6

# ---- Branding ----
BRAND_NAME=Indira Pathshala
BRAND_HANDLE=@indirapathshala

# ---- Telegram ----
# Bot token from @BotFather. Add the bot as an admin of your channel.
TELEGRAM_BOT_TOKEN=
# Channel username (@yourchannel) or numeric id (-100...)
TELEGRAM_CHANNEL_ID=
# Comma-separated numeric Telegram user ids allowed to use /generate /preview /history
TELEGRAM_ADMIN_IDS=
TELEGRAM_SEND_VIDEO=true
# Daily auto-post times used by `python -m pathshala_bot bot`
POST_TIMES=08:00,18:00
POST_TIMEZONE=Asia/Kolkata

# ---- YouTube Shorts (python scripts/youtube_auth.py to get the refresh token) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# ---- Instagram Reels (Instagram professional account + Graph API token) ----
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_VERSION=v21.0
# Optional: public URL where ./output is mirrored; otherwise videos are uploaded directly
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/pathshala

# ---- Voice-over ----
# auto = ElevenLabs if it works, else Microsoft Edge TTS (free), else silent video
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
