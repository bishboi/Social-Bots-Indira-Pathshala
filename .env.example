# =============================================================================
#  Indira Pathshala – example environment file
#
#  1. Copy it:   cp .env.example .env
#  2. Fill in at least the REQUIRED values below.
#  3. Start:     python -m pathshala_bot serve     (admin panel on http://localhost:8080)
#
#  .env is git-ignored – never commit real keys.
#  Most settings can also be changed later in the admin panel; panel values are
#  saved to output/control.json and take priority over this file. On the very
#  first start the panel is pre-filled from the values here.
#
#  Blank lines like KEY= mean "not set". Lines starting with # are examples /
#  defaults – remove the # to change them.
# =============================================================================


# -----------------------------------------------------------------------------
#  ADMIN PANEL                                               REQUIRED for `serve`
# -----------------------------------------------------------------------------
# Login for the web panel (HTTP Basic auth). Use a long, unique password and put
# the panel behind HTTPS if it is reachable from the internet.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where the panel stores its settings (default: <OUTPUT_DIR>/control.json)
# CONTROL_FILE=output/control.json


# -----------------------------------------------------------------------------
#  AI PROVIDER (research with web search + writing)                    REQUIRED
# -----------------------------------------------------------------------------
# Which AI to use for everything: anthropic (Claude) or openai.
# Only the key for the chosen provider is needed. Can be switched in the panel.
LLM_PROVIDER=anthropic

# Anthropic: https://console.anthropic.com → API Keys.   Format: sk-ant-...
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI: https://platform.openai.com/api-keys.   Format: sk-...
# The model must support the web_search tool and structured outputs (Responses API).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# How hard the model thinks (low | medium | high | xhigh | max) – used by both providers
# RESEARCH_EFFORT=medium
# GENERATION_EFFORT=high
# Max web searches per research step (the newspaper uses at least 12)
# MAX_WEB_SEARCHES=6
# Second AI call that checks / rewrites memory tricks (true | false)
# MNEMONIC_REVIEW=true


# -----------------------------------------------------------------------------
#  BRANDING
# -----------------------------------------------------------------------------
BRAND_NAME=Indira Pathshala
# Shown on videos, PDFs and captions – usually your Telegram channel username
BRAND_HANDLE=@indirapathshala
# Logo used on PDFs and the newspaper masthead
# BRAND_LOGO=assets/brand/logo.png
# Name in the © line (blank = BRAND_NAME)
# COPYRIGHT_OWNER=Indira Pathshala
# Faint logo + name watermark on every PDF page
PDF_WATERMARK=true


# -----------------------------------------------------------------------------
#  TELEGRAM                                          REQUIRED to post to Telegram
# -----------------------------------------------------------------------------
# 1. Message @BotFather → /newbot → copy the token.   Format: 123456789:AAH...
# 2. Add the bot to your channel as an ADMIN (with "Post messages" permission).
TELEGRAM_BOT_TOKEN=

# Main channel: @yourchannel  or the numeric id  -1001234567890
# (more channels can be added in the admin panel → Channels)
TELEGRAM_CHANNEL_ID=

# Numeric Telegram user ids allowed to use /preview /generate /akhbar /history.
# Find yours by messaging @userinfobot.  Comma separated: 11111111,22222222
TELEGRAM_ADMIN_IDS=

# Also post the short video in the Telegram channel
TELEGRAM_SEND_VIDEO=true

# Timezone for all schedules
POST_TIMEZONE=Asia/Kolkata
# Only used by the legacy `python -m pathshala_bot bot` command and to pre-fill
# the first schedule in the panel. HH:MM, comma separated.
POST_TIMES=08:00,18:00


# -----------------------------------------------------------------------------
#  YOUTUBE SHORTS                                                      OPTIONAL
# -----------------------------------------------------------------------------
# 1. Google Cloud Console → enable "YouTube Data API v3".
# 2. Credentials → Create OAuth client ID → type "Desktop app".
# 3. Put the id/secret below, then run:  python scripts/youtube_auth.py
#    and paste the printed refresh token.
# Until Google audits your API project, uploads are forced to private.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public


# -----------------------------------------------------------------------------
#  INSTAGRAM REELS                                                     OPTIONAL
# -----------------------------------------------------------------------------
# Needs an Instagram PROFESSIONAL account linked to a Facebook Page and a Meta app
# with instagram_basic + instagram_content_publish. Use a long-lived access token.
# INSTAGRAM_USER_ID is the numeric IG business account id (e.g. 17841400000000000).
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_VERSION=v21.0
# Optional: public URL where ./output is mirrored (CDN / bucket). If blank, videos
# are uploaded directly to Instagram, which is what most setups want.
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/pathshala


# -----------------------------------------------------------------------------
#  VOICE-OVER FOR SHORTS                                               OPTIONAL
# -----------------------------------------------------------------------------
# auto = ElevenLabs if a key works, else Microsoft Edge TTS (free), else silent
# Options: auto | elevenlabs | edge | none
TTS_PROVIDER=auto

# Best Hindi voice. Get a key at https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Free fallback voices (Microsoft Edge TTS)
# EDGE_VOICE_HI=hi-IN-SwaraNeural
# EDGE_VOICE_EN=en-IN-NeerjaNeural


# -----------------------------------------------------------------------------
#  DAILY CURRENT-AFFAIRS NEWSPAPER (AKHBAR)                            OPTIONAL
# -----------------------------------------------------------------------------
# AKHBAR_TITLE_HI=इंदिरा पाठशाला समसामयिकी पत्रिका
# AKHBAR_TITLE_EN=Indira Pathshala Samsamayiki Patrika
# Maximum articles per edition (4-16)
# AKHBAR_ARTICLES=10


# -----------------------------------------------------------------------------
#  VIDEO & MEDIA                                                       OPTIONAL
# -----------------------------------------------------------------------------
# Frame rate of the Manim shorts (lower = faster rendering)
# MANIM_FPS=30
# Wikimedia asks API clients to identify themselves – add a contact URL or email
# WIKI_USER_AGENT=IndiraPathshalaBot/1.0 (https://t.me/yourchannel)


# -----------------------------------------------------------------------------
#  STORAGE & PATHS                                                     OPTIONAL
# -----------------------------------------------------------------------------
# Generated posts, PDFs, videos, history and panel settings
# OUTPUT_DIR=output
# DB_PATH=output/history.sqlite3
# Fonts for slides / PDFs (run scripts/fetch_fonts.sh to re-download)
# FONTS_DIR=assets/fonts
# Exam catalogue (subjects and seed topics)
# EXAMS_FILE=pathshala_bot/exams.yaml
